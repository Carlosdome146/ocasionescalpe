{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ocasionescalpe",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/media/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ocasiones-calpe-db",
      "database_id": "fe635bbe-57fc-4699-b8f4-a7010b839a11"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ocasiones-calpe-media",
      "jurisdiction": "eu"
    }
  ]
}
